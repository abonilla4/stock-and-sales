{
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(pnpm dlx vercel:*)",
      "Bash(supabase db reset:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(supabase projects delete:*)",
      "Bash(supabase link:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh api:*)",
      "Edit(./.agents/Docs/**)",
      "Write(./.agents/Docs/**)",
      "Edit(./.claude/hooks/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "mcp__supabase__execute_sql",
      "mcp__supabase__apply_migration",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__create_project",
      "mcp__supabase__delete_branch",
      "mcp__supabase__merge_branch",
      "mcp__supabase__pause_project",
      "mcp__supabase__restore_project"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Bash(git rebase:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh"
          }
        ]
      }
    ]
  }
}
